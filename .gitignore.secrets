# 1Password Secrets - NEVER COMMIT THESE FILES
# This file should be included in all repositories' .gitignore

# Environment configuration files with secrets
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development
.env.test
.env.backup
.env.*.backup

# 1Password specific files
.env.1password
.env.1password.bak
.1password/
.secrets-logs/
.secrets-cache/

# SSH keys and certificates
*.pem
*.key
*.pub
id_rsa
id_rsa.pub
id_ecdsa
id_ecdsa.pub
ssh_key
ssh_key.pub

# Private keys
*.gpg
*.asc
private_key
private.key
.ssh/config
.ssh/authorized_keys

# Credentials and tokens
.credentials
credentials.json
credentials.yaml
token.json
token.txt
secrets.json
secrets.yaml
.auth
auth.json

# API Keys and secrets
*.apikey
*.api_key
api_key.txt
api_secrets.json

# Database credentials
db_password.txt
database.credentials
.dbconnect

# OAuth tokens and secrets
oauth_token.json
access_token.txt
refresh_token.txt

# AWS credentials
.aws/credentials
.aws/config
aws_credentials.json
AWS_SECRET_ACCESS_KEY

# GCP credentials
google-cloud-credentials.json
gcp-*.json
service-account-*.json

# Azure credentials
azure_credentials.json
.azure/
*.azureauth

# Private configuration
config.local.json
config.local.yaml
settings.local.json
local_settings.py

# Backup files with secrets
*.backup
*.bak
*.old
*.tmp
*.swp
*~

# IDE secrets and local settings
.idea/workspace.xml
.idea/shelf/
.vscode/settings.json
.vscode/launch.json
.DS_Store
.env.sublime-settings

# Logs that might contain secrets
logs/
*.log
debug.log
error.log
server.log

# Build artifacts that might contain secrets
build/
dist/
*.build
node_modules/
.next/
.env.local.js

# Docker secrets
docker-compose.override.yml
.dockerenv.local
docker_secrets/

# Kubernetes secrets
k8s/secrets/
secrets/
*.secret.yaml
secret-*.yaml

# Temporary files
tmp/
temp/
cache/
.cache/

# Coverage reports (might contain paths with secrets)
coverage/.env
htmlcov/.env
.coverage.env

# Lock files that might reference private registries
package-lock.json.bak
yarn.lock.bak
poetry.lock.bak

# Any file starting with dot that isn't tracked
!/.env.example
!/.env.*.example
!/.gitignore
!