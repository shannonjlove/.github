{
  "version": "1.0",
  "deployment": {
    "servers": [
      {
        "name": "api-mcp-server",
        "type": "nodejs-mcp",
        "path": "./api-mcp-server",
        "secrets_vault": "MCP Deployment",
        "secrets": [
          {
            "env_var": "NPM_TOKEN",
            "op_item": "npm-credentials",
            "op_field": "token"
          },
          {
            "env_var": "GITHUB_TOKEN",
            "op_item": "github-credentials",
            "op_field": "token"
          }
        ]
      },
      {
        "name": "claude-memory-mcp",
        "type": "python-mcp",
        "path": "./claude-memory-mcp",
        "secrets_vault": "MCP Deployment",
        "secrets": [
          {
            "env_var": "CLAUDE_API_KEY",
            "op_item": "claude-credentials",
            "op_field": "api_key"
          }
        ]
      },
      {
        "name": "github-mcp-server",
        "type": "go-mcp",
        "path": "./github-mcp-server",
        "secrets_vault": "MCP Deployment",
        "secrets": [
          {
            "env_var": "GITHUB_TOKEN",
            "op_item": "github-credentials",
            "op_field": "token"
          }
        ]
      },
      {
        "name": "mcp-ssh-server",
        "type": "typescript-mcp",
        "path": "./mcp-ssh-server",
        "secrets_vault": "MCP Deployment",
        "secrets": [
          {
            "env_var": "SSH_PRIVATE_KEY",
            "op_item": "ssh-credentials",
            "op_field": "private_key"
          },
          {
            "env_var": "SSH_KNOWN_HOSTS",
            "op_item": "ssh-credentials",
            "op_field": "known_hosts"
          }
        ]
      }
    ],
    "vaults": {
      "default": "MCP Deployment",
      "available": [
        "MCP Deployment",
        "Staging Secrets",
        "Production Secrets"
      ]
    }
  },
  "environments": {
    "development": {
      "vault": "MCP Deployment",
      "docker_registry": "ghcr.io",
      "deploy_timeout": 300
    },
    "staging": {
      "vault": "Staging Secrets",
      "docker_registry": "ghcr.io",
      "deploy_timeout": 600
    },
    "production": {
      "vault": "Production Secrets",
      "docker_registry": "ghcr.io",
      "deploy_timeout": 900,
      "require_approval": true
    }
  },
  "notifications": {
    "on_deployment": true,
    "on_failure": true,
    "slack_webhook": "op://MCP Deployment/slack-webhook/token"
  }
}
