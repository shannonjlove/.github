[Unit]
Description=Memory Agent - Long-term Memory & Context Management
Documentation=https://github.com/shannonjlove/memory-agent
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/shannonjlove/memory-agent:latest
ContainerName=memory-agent
PublishPort=127.0.0.1:8812:8812
Networks=app-net
Volume=/var/podman/memory-agent/data:/app/data
Volume=/var/podman/memory-agent/config:/app/config
EnvironmentFile=/etc/podman/secrets/memory-agent.env
Environment=AGENT_PORT=8812
Environment=TZ=UTC
HealthCheck=curl -f http://localhost:8812/health || exit 1
AutoUpdate=registry

[Service]
Type=simple
Restart=always
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
