# Rclone MCP Configuration
# Copy to /etc/podman/secrets/rclone-mcp.env and set actual values
# chmod 600 /etc/podman/secrets/rclone-mcp.env

# Rclone Remote Configuration
RCLONE_CONFIG=/root/.config/rclone/rclone.conf

# Remote Credentials (example for S3)
RCLONE_S3_ACCESS_KEY_ID=your_access_key
RCLONE_S3_SECRET_ACCESS_KEY=your_secret_key

# Or example for B2
RCLONE_B2_ACCOUNT_ID=your_account_id
RCLONE_B2_APP_KEY=your_app_key

TZ=UTC
