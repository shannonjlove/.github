# Tailscale Configuration
# Copy to /etc/podman/secrets/tailscale.env and set actual values
# chmod 600 /etc/podman/secrets/tailscale.env

# Tailscale Auth Key (generate from https://login.tailscale.com/admin/settings/keys)
# Use --auth-once flag for ephemeral keys that auto-cleanup
TS_AUTHKEY=tskey-xxxxxxxxxxxxxxxxxxxxx

# Hostname for this device on the tailnet
TS_HOSTNAME=shannonjlove-vps

# Enable IP forwarding for subnet routes
TS_IP_FORWARD=1

TZ=UTC
