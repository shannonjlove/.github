# Paperless-ngx Configuration
# Copy to /etc/podman/secrets/paperless.env and set actual values
# chmod 600 /etc/podman/secrets/paperless.env

PAPERLESS_SECRET_KEY=your-secret-key-here
PAPERLESS_TIME_ZONE=UTC
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=ChangeMe123!
PAPERLESS_ADMIN_MAIL=admin@example.com

# Database (if using external)
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=postgres
PAPERLESS_DBPORT=5432
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=ChangeMe123!

# OCR
PAPERLESS_OCR_LANGUAGE=eng
