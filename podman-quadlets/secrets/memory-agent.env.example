# Memory Agent Configuration
# Copy to /etc/podman/secrets/memory-agent.env and set actual values
# chmod 600 /etc/podman/secrets/memory-agent.env

AGENT_PORT=8812
LOG_LEVEL=info
TZ=UTC

# Database Configuration
DB_HOST=memory-postgres
DB_PORT=5432
DB_USER=memory_user
DB_PASSWORD=ChangeMeSecurePassword123!
DB_NAME=memory_db
