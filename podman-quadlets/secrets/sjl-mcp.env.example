# SJL MCP Server Configuration
# Copy to /etc/podman/secrets/sjl-mcp.env and set actual values
# chmod 600 /etc/podman/secrets/sjl-mcp.env

MCP_HOST=0.0.0.0
MCP_PORT=8811
LOG_LEVEL=info
TZ=UTC

# Oracle Cloud Configuration
OCI_CONFIG_PROFILE=default
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..aaaaaaaxxxxxxxxxxxxx

# File Operations
FILE_MAX_SIZE=1048576
SHELL_TIMEOUT=90

# API Keys (if using Brave Search)
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
