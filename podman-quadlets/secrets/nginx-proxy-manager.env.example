# Nginx Proxy Manager Configuration
# Copy to /etc/podman/secrets/nginx-proxy-manager.env and set actual values
# chmod 600 /etc/podman/secrets/nginx-proxy-manager.env

DB_MYSQL_HOST=nginx-proxy-db
DB_MYSQL_PORT=3306
DB_MYSQL_USER=npm
DB_MYSQL_PASSWORD=ChangeMeSecurePassword123!
DB_MYSQL_NAME=npm

DISABLE_IPV6=false
TZ=UTC
