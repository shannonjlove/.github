# PIBN Infrastructure Monitoring Configuration
# Copy to /etc/podman/secrets/pibn.env and set actual values
# chmod 600 /etc/podman/secrets/pibn.env

# Core Configuration
LOG_LEVEL=info
TZ=UTC
ENVIRONMENT=production

# API Configuration
API_PORT=9090
API_BIND_ADDRESS=127.0.0.1

# Database (if applicable)
DB_HOST=pibn-db
DB_PORT=5432
DB_USER=pibn
DB_PASSWORD=ChangeMeSecurePassword123!
