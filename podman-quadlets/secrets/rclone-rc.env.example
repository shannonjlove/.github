# Rclone Remote Control Configuration
# Copy to /etc/podman/secrets/rclone-rc.env and set actual values
# chmod 600 /etc/podman/secrets/rclone-rc.env

# Rclone Configuration
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
RCLONE_RC_ADDR=127.0.0.1:5571

# Authentication (if needed)
RCLONE_RC_USER=username
RCLONE_RC_PASS=password

TZ=UTC
