# SJL File API Configuration
# Copy to /etc/podman/secrets/sjl-file-api.env and set actual values
# chmod 600 /etc/podman/secrets/sjl-file-api.env

NODE_ENV=production
PORT=3000
API_KEY=your-api-key-here
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=104857600

# Database (if applicable)
DB_HOST=api-db
DB_PORT=5432
DB_USER=api_user
DB_PASSWORD=ChangeMe123!
DB_NAME=sjl_file_api

TZ=UTC
