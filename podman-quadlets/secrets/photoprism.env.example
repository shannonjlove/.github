# PhotoPrism Configuration
# Copy to /etc/podman/secrets/photoprism.env and set actual values
# chmod 600 /etc/podman/secrets/photoprism.env

PHOTOPRISM_ADMIN_PASSWORD=ChangeMe123!
PHOTOPRISM_ADMIN_USER=admin

# Database
PHOTOPRISM_DATABASE_DRIVER=sqlite
# For MySQL: PHOTOPRISM_DATABASE_DRIVER=mysql
# PHOTOPRISM_DATABASE_DSN=root:password@tcp(db:3306)/photoprism

# API
PHOTOPRISM_HTTP_HOST=0.0.0.0
PHOTOPRISM_HTTP_PORT=2342

# Features
PHOTOPRISM_READONLY=false
PHOTOPRISM_DISABLE_WEBDAV=false
PHOTOPRISM_DETECT_NSFW=false
PHOTOPRISM_UPLOAD_NSFW=true

TZ=UTC
