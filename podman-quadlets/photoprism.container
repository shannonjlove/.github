[Unit]
Description=PhotoPrism - Photo Management & AI Tagging
Documentation=https://docs.photoprism.app/
After=network-online.target
Wants=network-online.target

[Container]
Image=photoprism/photoprism:latest
ContainerName=photoprism
PublishPort=127.0.0.1:2342:2342
Networks=app-net
Volume=/var/podman/photoprism/storage:/photoprism/storage
Volume=/var/podman/photoprism/originals:/photoprism/originals
EnvironmentFile=/etc/podman/secrets/photoprism.env
Environment=TZ=UTC
HealthCheck=curl -f http://localhost:2342/ || exit 1
AutoUpdate=registry

[Service]
Type=simple
Restart=always
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
