[Unit]
Description=Rclone MCP Server - Cloud Storage Integration
Documentation=https://rclone.org/
After=network-online.target
Wants=network-online.target

[Container]
Image=rclone/rclone:latest
ContainerName=rclone-mcp
PublishPort=127.0.0.1:5572:5572
Networks=app-net,infra-net
Volume=/var/podman/rclone-mcp/config:/root/.config/rclone
Volume=/var/podman/rclone-mcp/data:/data
EnvironmentFile=/etc/podman/secrets/rclone-mcp.env
Environment=TZ=UTC
AutoUpdate=registry
Exec=rcd --rc-addr=0.0.0.0:5572

[Service]
Type=simple
Restart=always
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
