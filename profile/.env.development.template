# Development Environment Configuration
# Load secrets from 1Password using: op item get <item> --vault <vault> --fields <field>

# GitHub Configuration
GITHUB_TOKEN=op://Development Secrets/github-credentials/token
GITHUB_USERNAME=development-user
GITHUB_API_URL=https://api.github.com

# NPM Configuration
NPM_TOKEN=op://Development Secrets/npm-credentials/token
NPM_REGISTRY=https://registry.npmjs.org
NPM_SCOPE=@your-org

# Claude AI Configuration
CLAUDE_API_KEY=op://Development Secrets/claude-credentials/api_key
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_API_URL=https://api.anthropic.com

# Database Configuration (if applicable)
DATABASE_URL=op://Development Secrets/database-connection/connection_string
DATABASE_USER=op://Development Secrets/database-connection/username
DATABASE_PASSWORD=op://Development Secrets/database-connection/password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=development_db

# SSH Configuration (if applicable)
SSH_PRIVATE_KEY=op://Development Secrets/ssh-credentials/private_key
SSH_PUBLIC_KEY=op://Development Secrets/ssh-credentials/public_key
SSH_KNOWN_HOSTS=op://Development Secrets/ssh-credentials/known_hosts
SSH_KEY_PASSPHRASE=op://Development Secrets/ssh-credentials/passphrase

# OAuth Configuration
OAUTH_CLIENT_ID=op://Development Secrets/oauth-credentials/client_id
OAUTH_CLIENT_SECRET=op://Development Secrets/oauth-credentials/client_secret
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Logging Configuration
LOG_LEVEL=debug
DEBUG=true
LOG_FILE=./logs/development.log

# Application Configuration
ENVIRONMENT=development
PORT=3000
HOST=localhost
NODE_ENV=development
PYTHONUNBUFFERED=1

# Feature Flags
ENABLE_EXPERIMENTAL_FEATURES=true
ENABLE_DEBUG_LOGGING=true
SKIP_AUTH_CHECKS=false
