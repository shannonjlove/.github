# Staging Environment Configuration
# Load secrets from 1Password using: op item get <item> --vault <vault> --fields <field>

# GitHub Configuration
GITHUB_TOKEN=op://Staging Secrets/github-credentials/token
GITHUB_USERNAME=staging-user
GITHUB_API_URL=https://api.github.com

# NPM Configuration
NPM_TOKEN=op://Staging Secrets/npm-credentials/token
NPM_REGISTRY=https://registry.npmjs.org
NPM_SCOPE=@your-org

# Claude AI Configuration
CLAUDE_API_KEY=op://Staging Secrets/claude-credentials/api_key
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_API_URL=https://api.anthropic.com

# Database Configuration (if applicable)
DATABASE_URL=op://Staging Secrets/database-connection/connection_string
DATABASE_USER=op://Staging Secrets/database-connection/username
DATABASE_PASSWORD=op://Staging Secrets/database-connection/password
DATABASE_HOST=staging-db.internal
DATABASE_PORT=5432
DATABASE_NAME=staging_db

# SSH Configuration (if applicable)
SSH_PRIVATE_KEY=op://Staging Secrets/ssh-credentials/private_key
SSH_PUBLIC_KEY=op://Staging Secrets/ssh-credentials/public_key
SSH_KNOWN_HOSTS=op://Staging Secrets/ssh-credentials/known_hosts
SSH_KEY_PASSPHRASE=op://Staging Secrets/ssh-credentials/passphrase

# OAuth Configuration
OAUTH_CLIENT_ID=op://Staging Secrets/oauth-credentials/client_id
OAUTH_CLIENT_SECRET=op://Staging Secrets/oauth-credentials/client_secret
OAUTH_REDIRECT_URI=https://staging.example.com/auth/callback

# Logging Configuration
LOG_LEVEL=info
DEBUG=false
LOG_FILE=/var/log/app/staging.log

# Application Configuration
ENVIRONMENT=staging
PORT=443
HOST=0.0.0.0
NODE_ENV=production
PYTHONUNBUFFERED=1

# Feature Flags
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_DEBUG_LOGGING=false
SKIP_AUTH_CHECKS=false

# Monitoring
SENTRY_DSN=op://Staging Secrets/monitoring/sentry_dsn
DATADOG_API_KEY=op://Staging Secrets/monitoring/datadog_key
