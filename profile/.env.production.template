# Production Environment Configuration
# CRITICAL: All secrets are stored in 1Password vault "Production Secrets"
# Load secrets using: op item get <item> --vault "Production Secrets" --fields <field>

# GitHub Configuration
GITHUB_TOKEN=op://Production Secrets/github-credentials/token
GITHUB_USERNAME=production-service
GITHUB_API_URL=https://api.github.com

# NPM Configuration
NPM_TOKEN=op://Production Secrets/npm-credentials/token
NPM_REGISTRY=https://registry.npmjs.org
NPM_SCOPE=@your-org

# Claude AI Configuration
CLAUDE_API_KEY=op://Production Secrets/claude-credentials/api_key
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_API_URL=https://api.anthropic.com

# Database Configuration (CRITICAL: Use production database)
DATABASE_URL=op://Production Secrets/database/connection_string
DATABASE_USER=op://Production Secrets/database/username
DATABASE_PASSWORD=op://Production Secrets/database/password
DATABASE_HOST=prod-db.internal
DATABASE_PORT=5432
DATABASE_NAME=production_db
DATABASE_POOL_SIZE=20
DATABASE_SSL=true

# SSH Configuration
SSH_PRIVATE_KEY=op://Production Secrets/ssh-credentials/private_key
SSH_PUBLIC_KEY=op://Production Secrets/ssh-credentials/public_key
SSH_KNOWN_HOSTS=op://Production Secrets/ssh-credentials/known_hosts
SSH_KEY_PASSPHRASE=op://Production Secrets/ssh-credentials/passphrase

# OAuth Configuration
OAUTH_CLIENT_ID=op://Production Secrets/oauth-credentials/client_id
OAUTH_CLIENT_SECRET=op://Production Secrets/oauth-credentials/client_secret
OAUTH_REDIRECT_URI=https://example.com/auth/callback

# Logging Configuration (CRITICAL: Monitor production logs)
LOG_LEVEL=warn
DEBUG=false
LOG_FILE=/var/log/app/production.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=90

# Application Configuration
ENVIRONMENT=production
PORT=443
HOST=0.0.0.0
NODE_ENV=production
PYTHONUNBUFFERED=1

# Security Configuration (CRITICAL)
REQUIRE_HTTPS=true
SECURE_COOKIES=true
CORS_ENABLED=true
CORS_ORIGINS=https://example.com
SESSION_SECURE=true
CSRF_PROTECTION=true

# Feature Flags (PRODUCTION: Disabled by default)
ENABLE_EXPERIMENTAL_FEATURES=false
ENABLE_DEBUG_LOGGING=false
SKIP_AUTH_CHECKS=false

# Monitoring & Alerting (CRITICAL: Enable for production)
SENTRY_DSN=op://Production Secrets/monitoring/sentry_dsn
SENTRY_ENVIRONMENT=production
DATADOG_API_KEY=op://Production Secrets/monitoring/datadog_key
DATADOG_ENABLED=true

# Performance Optimization
CACHE_ENABLED=true
CACHE_TTL=3600
COMPRESSION_ENABLED=true

# Backup & Disaster Recovery
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
DISASTER_RECOVERY_ENABLED=true

# Compliance & Security Audit
AUDIT_LOGGING=true
AUDIT_LOG_FILE=/var/log/app/audit.log
GDPR_COMPLIANCE=true
